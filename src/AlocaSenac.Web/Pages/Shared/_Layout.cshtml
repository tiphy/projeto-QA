<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] - Gestão de Salas Senac</title>
    <style>
        :root { font-family: system-ui, sans-serif; color: #17324d; background: #f3f6f9; }
        * { box-sizing: border-box; }
        body { margin: 0; min-height: 100vh; }
        .app { display: flex; min-height: 100vh; }
        .sidebar { width: 250px; flex: 0 0 250px; padding: 1.5rem 1rem; color: #fff; background: #07528a; }
        .brand { margin: 0 0 2rem; font-size: 1.35rem; }
        .brand small { display: block; margin-top: .3rem; font-size: .75rem; font-weight: 400; opacity: .8; }
        .sidebar nav { display: grid; gap: .35rem; }
        .sidebar a { display: block; padding: .7rem .8rem; color: #fff; text-decoration: none; border-radius: 6px; }
        .sidebar a:hover, .sidebar a[aria-current="page"] { background: #126da8; }
        .workspace { min-width: 0; flex: 1; }
        .topbar { display: flex; justify-content: flex-end; align-items: center; gap: .7rem; min-height: 68px; padding: 1rem 2rem; background: #fff; border-bottom: 1px solid #dce5ec; }
        .avatar { display: grid; width: 2.25rem; height: 2.25rem; place-items: center; border-radius: 50%; color: #07528a; background: #e6f1f8; font-weight: 700; }
        main { max-width: 1440px; margin: 0 auto; padding: 2rem; }
        h1, h2, h3, p { margin-top: 0; }
        h1 { margin-bottom: .35rem; }
        .muted { color: #607387; }
        .grid { display: grid; gap: 1rem; }
        .cards { grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); margin: 1.5rem 0; }
        .card, .panel { padding: 1.25rem; background: #fff; border: 1px solid #dce5ec; border-radius: 10px; }
        .metric { margin: .25rem 0 0; font-size: 1.8rem; font-weight: 700; }
        .actions { display: flex; flex-wrap: wrap; align-items: center; gap: .65rem; }
        button, .button { padding: .65rem .9rem; color: #fff; background: #0876b9; border: 0; border-radius: 6px; font: inherit; text-decoration: none; cursor: pointer; }
        button.secondary, .button.secondary { color: #17405f; background: #e7eef4; }
        input, select { max-width: 100%; padding: .6rem .7rem; border: 1px solid #bccbd7; border-radius: 5px; font: inherit; }
        label { display: grid; gap: .35rem; }
        .filters { display: flex; flex-wrap: wrap; gap: .75rem; margin: 1rem 0; }
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: .75rem .5rem; border-bottom: 1px solid #e3eaf0; text-align: left; }
        th { color: #526579; font-size: .9rem; }
        .alerta { margin: 1rem 0; padding: .75rem 1rem; border-radius: 6px; }
        .alerta.sucesso { color: #1e5b2d; background: #e6f4ea; }
        .alerta.erro { color: #8a1c1c; background: #fde8e8; }
        .status { display: inline-block; padding: .25rem .55rem; background: #fff2cc; border-radius: 999px; font-size: .85rem; }
        @@media (max-width: 720px) {
            .app { display: block; }
            .sidebar { width: auto; }
            .sidebar nav { grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); }
            main { padding: 1.25rem; }
            .topbar { padding: 1rem 1.25rem; }
        }
    </style>
</head>
<body>
    <div class="app">
        <aside class="sidebar">
            <p class="brand">Senac <small>Gestão de Salas</small></p>
            <nav aria-label="Navegação principal">
                <a asp-page="/Dashboard/Index">Dashboard</a>
                <a asp-page="/Salas/Index">Salas</a>
                <a asp-page="/Agendamentos/Index">Agendamentos</a>
                <a asp-page="/Relatorios/Index">Relatórios</a>
                <a asp-page="/Configuracoes/Index">Configurações</a>
            </nav>
        </aside>
        <div class="workspace">
            <header class="topbar">
                <span>Perfil administrativo</span>
                <span class="avatar" aria-label="Perfil Senac">S</span>
            </header>
            <main>
                @RenderBody()
            </main>
        </div>
    </div>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
