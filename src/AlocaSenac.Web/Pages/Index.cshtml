@page
@model IndexModel
@{
    ViewData["Title"] = "AlocaSenac";
    var podeSolicitar = Model.Persona == "Solicitante";
    var podeAdministrar = Model.Persona == "Administrador";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@ViewData["Title"] — Gestão de espaços</title>
    <style>
        :root { font-family: system-ui, sans-serif; color: #172b4d; background: #f4f7fb; }
        body { margin: 0; }
        header { padding: 1.25rem max(1rem, calc((100% - 1050px) / 2)); background: #123b5d; color: white; }
        main { max-width: 1050px; margin: 2rem auto; padding: 0 1rem; }
        h1, h2, p { margin-top: 0; }
        .layout { display: grid; grid-template-columns: minmax(260px, 1fr) 2fr; gap: 1rem; align-items: start; }
        .card { background: white; border: 1px solid #dce5ee; border-radius: 10px; padding: 1.25rem; }
        .personas { display: flex; flex-wrap: wrap; gap: .5rem; margin-bottom: 1rem; }
        .personas a, button { display: inline-block; border: 0; border-radius: 6px; padding: .65rem .9rem; background: #e7eef5; color: #123b5d; text-decoration: none; font: inherit; cursor: pointer; }
        .personas a[aria-current="page"], button.primary { background: #1769aa; color: white; }
        label { display: block; margin: .85rem 0 .3rem; font-weight: 600; }
        input { box-sizing: border-box; width: 100%; padding: .65rem; border: 1px solid #bdcbd8; border-radius: 6px; font: inherit; }
        .muted { color: #526579; }
        .notice { padding: .75rem; border-radius: 6px; background: #e7f5eb; }
        .error { color: #a32121; }
        .table-wrap { overflow-x: auto; }
        table { width: 100%; border-collapse: collapse; }
        th, td { padding: .75rem .5rem; border-bottom: 1px solid #e3eaf0; text-align: left; }
        th { color: #526579; }
        .small-button { padding: .4rem .6rem; background: #fae7e7; color: #8c2525; }
        @@media (max-width: 700px) { .layout { grid-template-columns: 1fr; } }
    </style>
</head>
<body>
    <header>
        <h1>AlocaSenac</h1>
        <p>Gestão simples de salas e espaços acadêmicos</p>
    </header>
    <main>
        <nav class="personas" aria-label="Selecionar perfil de demonstração">
            @foreach (var persona in new[] { "Solicitante", "Responsável", "Administrador" })
            {
                <a asp-page="/Index" asp-route-persona="@persona" aria-current="@(Model.Persona == persona ? "page" : null)">@persona</a>
            }
        </nav>

        @if (Model.Aviso is not null)
        {
            <p class="notice" role="status">@Model.Aviso</p>
        }

        @if (Model.Persona == "Responsável")
        {
            <p class="card muted">Visão de acompanhamento da agenda. O sistema atual ainda não possui etapa de aprovação ou recusa de solicitações.</p>
        }

        <div class="layout">
            @if (podeSolicitar)
            {
                <section class="card">
                    <h2>Solicitar espaço</h2>
                    <p class="muted">Informe o espaço e o período desejado.</p>
                    <form method="post" asp-page-handler="Create">
                        <input type="hidden" name="persona" value="@Model.Persona" />
                        <label for="sala">Sala ou espaço</label>
                        <input id="sala" name="sala" maxlength="120" required placeholder="Ex.: Laboratório 101" />

                        <label for="professor">Solicitante ou responsável</label>
                        <input id="professor" name="professor" maxlength="120" required placeholder="Ex.: Ana Souza" />

                        <label for="inicio">Início</label>
                        <input id="inicio" name="inicio" type="datetime-local" required />

                        <label for="fim">Término</label>
                        <input id="fim" name="fim" type="datetime-local" required />

                        @foreach (var erro in ModelState.Values.SelectMany(value => value.Errors))
                        {
                            <p class="error" role="alert">@erro.ErrorMessage</p>
                        }

                        <button class="primary" type="submit">Criar alocação</button>
                    </form>
                </section>
            }

            <section class="card">
                <h2>Agenda de espaços</h2>
                <p class="muted">@Model.Alocacoes.Count alocação(ões) cadastrada(s)</p>
                @if (Model.Alocacoes.Count == 0)
                {
                    <p>Nenhuma alocação cadastrada.</p>
                }
                else
                {
                    <div class="table-wrap">
                        <table>
                            <thead>
                                <tr><th>Espaço</th><th>Responsável</th><th>Início</th><th>Término</th>@if (podeAdministrar) { <th>Ação</th> }</tr>
                            </thead>
                            <tbody>
                                @foreach (var alocacao in Model.Alocacoes)
                                {
                                    <tr>
                                        <td>@alocacao.Sala</td>
                                        <td>@alocacao.Professor</td>
                                        <td>@alocacao.Inicio.ToString("dd/MM/yyyy HH:mm")</td>
                                        <td>@alocacao.Fim.ToString("dd/MM/yyyy HH:mm")</td>
                                        @if (podeAdministrar)
                                        {
                                            <td>
                                                <form method="post" asp-page-handler="Delete">
                                                    <input type="hidden" name="persona" value="@Model.Persona" />
                                                    <input type="hidden" name="id" value="@alocacao.Id" />
                                                    <button class="small-button" type="submit">Remover</button>
                                                </form>
                                            </td>
                                        }
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </section>
        </div>
        <p class="muted">Demonstração: os perfis são apenas uma seleção de interface, sem autenticação. As alocações ficam em memória e são perdidas ao reiniciar a aplicação.</p>
    </main>
</body>
</html>
